# LLM Providers (For generating coin commentary)
OPENAI_API_KEY=
GEMINI_API_KEY=

# CoinMarketCap (Optional - public scraping fallback is used if empty)
CMC_API_KEY=

# Database / Cloud Persistence Provider ("firebase" or "mongo")
DATA_STORE=firebase

# MongoDB Atlas (Optional - alternative to Firebase on AWS / Railway)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?appName=Cluster0

# Firebase Firestore Cloud Database
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=(default)

# Alternatively, single JSON configuration string:
# FIREBASE_CONFIG=

# CoinMarketCap Automated Browser Session State (Optional - can also be imported in App UI)
AUTH_STATE_JSON=
