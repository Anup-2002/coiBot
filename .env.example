# ==============================================================================
# COINMARKETCAP TRENDING BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Path where Playwright Chromium binaries are installed (default: ./.cache/ms-playwright)
PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright

# ------------------------------------------------------------------------------
# 2. AI COMMENT GENERATORS (At least ONE key is recommended)
# ------------------------------------------------------------------------------
# Primary Model: OpenAI gpt-4o-mini
OPENAI_API_KEY=

# Fallback Model: Google Gemini gemini-3.5-flash
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # Alternative alias for GEMINI_API_KEY

# ------------------------------------------------------------------------------
# 3. COINMARKETCAP DATA SOURCE (Optional)
# ------------------------------------------------------------------------------
# Optional: Pro API Key from pro.coinmarketcap.com
# If left empty, bot automatically uses CoinMarketCap's public trending feeds with zero keys needed!
CMC_API_KEY=

# ------------------------------------------------------------------------------
# 4. DATABASE & CLOUD MULTI-PROFILE PERSISTENCE
# ------------------------------------------------------------------------------
# Database Provider: "firebase" (default) or "mongo"
DATA_STORE=firebase

# Option A: Firebase Firestore Configuration (Recommended)
# You can provide the full JSON string from Firebase Console:
# FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"...","firestoreDatabaseId":"(default)"}

# Or individual Firebase variables:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_DATABASE_URL=
FIREBASE_MEASUREMENT_ID=

# Option B: MongoDB Atlas (Alternative to Firebase)
# DATA_STORE=mongo
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/coinbot?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SESSION PERSISTENCE (Optional)
# ------------------------------------------------------------------------------
# Pre-loaded CoinMarketCap cookies JSON string (from Cookie-Editor).
# If left empty, you can import cookies directly through the web UI under "Import Session".
AUTH_STATE_JSON=

# ------------------------------------------------------------------------------
# 6. POSTING LIMITS & SAFETY GUARDRAILS
# ------------------------------------------------------------------------------
# Per-account daily post limit (default: 500 posts/day)
DAILY_POST_LIMIT=500


