# ==============================================================================
# CoinMarketCap Trending Bot & Posting Agent - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3005
NODE_ENV=production

# Emergency Telegram Hotline Notifications
# Default linked bot: @anup_cms_alert_bot
TELEGRAM_BOT_TOKEN=8698939017:AAHMbpwBznDWBLDJiW9-ogqvYODXbjA3wGU
TELEGRAM_CHAT_ID=1817931967

# Bot Operational Limits & AI Models
# Primary commentary model: gpt-4o-mini
OPENAI_API_KEY=
# Fallback commentary model: gemini-2.5-flash
GEMINI_API_KEY=
# Optional CoinMarketCap Pro API Key (public endpoints used by default)
CMC_API_KEY=
# Maximum posts allowed per account per calendar day (default 300)
DAILY_POST_LIMIT=300

# Browser Engine Environment (Playwright)
PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright

# Database & Cloud Storage Configuration
# Options for STORAGE_PROVIDER: "mongodb" | "firebase" | "dual"
STORAGE_PROVIDER=firebase
DISABLE_FIREBASE=false
PREFER_MONGODB=false
MONGO_URI=
DATA_STORE=

# Firebase Firestore Cloud Credentials
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_ID=
FIREBASE_DATABASE_URL=
FIREBASE_MEASUREMENT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ENABLE_FIRESTORE=true